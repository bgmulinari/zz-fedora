#!/usr/bin/env bash
# zz-name: refresh
# zz-summary: Replace user-owned configs with the current ZZ defaults.
# zz-usage: zz refresh <config-path>... | zz refresh --list
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
MANIFEST="$ROOT_DIR/config/managed-config.tsv"
DMS_UNIT="dms.service"
DMS_CHANGED=0
DEFAULT_WRITTEN=0

usage() {
  cat <<'EOF_USAGE'
Usage:
  zz refresh <config-path>...
  zz refresh --list

Replace user-owned configuration files with the current ZZ defaults.
If an existing file differs, it is saved beside the file as
<filename>.bak.<timestamp> before replacement.

Paths below ~/.config are written relative to ~/.config, for example:
  zz refresh niri/config.kdl
  zz refresh ghostty/config

Reset every DMS setting to the ZZ defaults (settings, plugin enablement,
and session state):
  zz refresh dms

DMS keeps its settings in memory and writes them back on any change, so a
running dms.service is restarted after a DMS file is replaced.
EOF_USAGE
}

# The DMS state seeds carry host paths and the planned plugin set, so they
# are rendered by lib/dms.sh instead of copied from a template.
rendered_default_emitter() {
  # Managed-config paths are written with a literal ~/ prefix.
  # shellcheck disable=SC2088
  case "$1" in
    "~/.config/DankMaterialShell/settings.json") printf 'dms_settings_seed_json\n' ;;
    "~/.config/DankMaterialShell/plugin_settings.json") printf 'dms_plugin_settings_seed_json\n' ;;
    "~/.local/state/DankMaterialShell/session.json") printf 'dms_session_seed_json\n' ;;
    *) return 1 ;;
  esac
}

# `dms` stands for every DMS file with a rendered default.
refresh_alias_keys() {
  [[ "$1" == "dms" ]] || return 1
  local path _source _description
  while IFS=$'\t' read -r path _source _description; do
    rendered_default_emitter "$path" >/dev/null || continue
    refresh_key_for_path "$path"
  done < <(refreshable_rows)
}

refresh_key_for_path() {
  local path="$1"
  case "$path" in
    \~/.config/*) printf '%s\n' "${path#\~/.config/}" ;;
    \~/*) printf '%s\n' "${path#\~/}" ;;
    *) return 1 ;;
  esac
}

# Seeded rows with a template to copy or a renderer to run.
refreshable_rows() {
  local component path mode _conflict source _required description
  while IFS=$'\t' read -r component path mode _conflict source _required description; do
    [[ -n "$component" && "$component" != \#* ]] || continue
    [[ "$mode" == "seed-if-missing" ]] || continue
    [[ "$source" != "-" ]] || rendered_default_emitter "$path" >/dev/null || continue
    printf '%s\t%s\t%s\n' "$path" "$source" "$description"
  done <"$MANIFEST"
}

list_refreshable_configs() {
  local path _source description key
  while IFS=$'\t' read -r path _source description; do
    key="$(refresh_key_for_path "$path" || true)"
    [[ -n "$key" ]] || continue
    printf '%-44s %s\n' "$key" "$description"
  done < <(refreshable_rows)
  printf '%-44s %s\n' dms "Resets every DMS setting: settings, plugin enablement, and session state."
}

normalize_refresh_key() {
  local key="$1"
  key="${key#\~/}"
  key="${key#.config/}"
  key="${key#/}"
  printf '%s\n' "$key"
}

next_backup_path() {
  local destination="$1"
  local candidate
  candidate="${destination}.bak.$(date +%s)"
  local suffix=1
  while [[ -e "$candidate" || -L "$candidate" ]]; do
    candidate="${destination}.bak.$(date +%s).$suffix"
    suffix=$((suffix + 1))
  done
  printf '%s\n' "$candidate"
}

load_dms_renderers() {
  declare -F dms_settings_seed_json >/dev/null && return 0
  TARGET_HOME="$HOME"
  # shellcheck source=../../lib/common.sh
  source "$ROOT_DIR/lib/common.sh"
  # shellcheck source=../../lib/files.sh
  source "$ROOT_DIR/lib/files.sh"
  # shellcheck source=../../lib/dms.sh
  source "$ROOT_DIR/lib/dms.sh"
}

# Write the current default for a manifest row to stdout.
emit_default() {
  local path="$1" source="$2" emitter
  if emitter="$(rendered_default_emitter "$path")"; then
    load_dms_renderers
    "$emitter"
    return
  fi
  [[ -f "$ROOT_DIR/$source" ]] || {
    printf 'ZZ default is missing: %s\n' "$ROOT_DIR/$source" >&2
    return 1
  }
  cat -- "$ROOT_DIR/$source"
}

refresh_config() {
  local wanted
  wanted="$(normalize_refresh_key "$1")"
  [[ -n "$wanted" && "$wanted" != *".."* ]] || {
    printf 'Invalid config path: %s\n' "$1" >&2
    return 1
  }

  local path source _description key
  local matched_path="" matched_source=""
  while IFS=$'\t' read -r path source _description; do
    key="$(refresh_key_for_path "$path" || true)"
    [[ "$key" == "$wanted" ]] || continue
    matched_path="$path"
    matched_source="$source"
    break
  done < <(refreshable_rows)

  [[ -n "$matched_path" ]] || {
    printf 'Not a refreshable ZZ config: %s\n\n' "$1" >&2
    printf 'Available configs:\n' >&2
    list_refreshable_configs >&2
    return 1
  }

  local destination="$HOME/${matched_path#\~/}"
  [[ "$destination" == "$HOME/"* ]] || {
    printf 'Refusing to refresh a path outside the home directory: %s\n' "$destination" >&2
    return 1
  }
  if [[ -e "$destination" || -L "$destination" ]] && [[ ! -f "$destination" ]]; then
    printf 'Refusing to replace a non-file config: %s\n' "$destination" >&2
    return 1
  fi

  local default_file status=0
  default_file="$(mktemp)" || return 1
  if emit_default "$matched_path" "$matched_source" >"$default_file"; then
    install_default "$destination" "$default_file" || status=$?
  else
    status=1
  fi
  rm -f -- "$default_file"
  [[ "$status" -eq 0 ]] || return "$status"

  if [[ "$DEFAULT_WRITTEN" -eq 1 ]] && rendered_default_emitter "$matched_path" >/dev/null; then
    DMS_CHANGED=1
  fi
}

# Callers test this with ||, which suspends errexit, so every write is
# checked explicitly. Sets DEFAULT_WRITTEN when the destination changed.
install_default() {
  local destination="$1" default_file="$2"
  DEFAULT_WRITTEN=0
  mkdir -p "$(dirname "$destination")" || return 1
  if [[ -e "$destination" || -L "$destination" ]]; then
    if [[ ! -L "$destination" ]] && cmp -s "$destination" "$default_file"; then
      printf '%s already matches the current ZZ default.\n' "$destination"
      return 0
    fi

    local backup
    backup="$(next_backup_path "$destination")" || return 1
    cp -aL -- "$destination" "$backup" || return 1
    rm -f -- "$destination" || return 1
    install -m 0644 "$default_file" "$destination" || return 1
    DEFAULT_WRITTEN=1
    printf 'Replaced %s with the current ZZ default.\n' "$destination"
    printf 'Saved backup as %s.\n\n' "$backup"
    printf 'Changes (backup -> default):\n'
    diff -u -- "$backup" "$destination" || true
  else
    install -m 0644 "$default_file" "$destination" || return 1
    DEFAULT_WRITTEN=1
    printf 'Installed the current ZZ default at %s.\n' "$destination"
  fi
}

# Without a restart the running shell would write its in-memory settings
# back over the refreshed file on the next change.
restart_dms_if_running() {
  [[ "$DMS_CHANGED" -eq 1 ]] || return 0
  if systemctl --user is-active --quiet "$DMS_UNIT" 2>/dev/null; then
    printf '\nRestarting %s so the shell loads the refreshed settings.\n' "$DMS_UNIT"
    systemctl --user restart "$DMS_UNIT"
  fi
}

main() {
  case "${1:-}" in
    -h|--help)
      usage
      ;;
    --list)
      [[ "$#" -eq 1 ]] || {
        usage >&2
        return 1
      }
      list_refreshable_configs
      ;;
    "")
      usage >&2
      return 1
      ;;
    *)
      local arg config status=0
      local -a configs=()
      for arg in "$@"; do
        if refresh_alias_keys "$arg" >/dev/null; then
          mapfile -t -O "${#configs[@]}" configs < <(refresh_alias_keys "$arg")
        else
          configs+=("$arg")
        fi
      done
      for config in "${configs[@]}"; do
        refresh_config "$config" || status=1
      done
      restart_dms_if_running
      return "$status"
      ;;
  esac
}

main "$@"
