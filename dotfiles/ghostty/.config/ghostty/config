# Shell
# Zsh is the interactive shell here only; the login shell (SHELL) stays bash
# so agents and other programs that run "the user's shell" get bash.
command = /usr/bin/zsh

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 10

# Window
window-padding-x = 8
window-padding-y = 8
window-decoration = server
window-inherit-working-directory = true

# Background
background-opacity = 0.90

# Shader
custom-shader = shaders/cursor_tail.glsl
custom-shader-animation = always

# Misc
copy-on-select = both
bold-color = bright
confirm-close-surface = false
quit-after-last-window-closed = false
theme = dankcolors
