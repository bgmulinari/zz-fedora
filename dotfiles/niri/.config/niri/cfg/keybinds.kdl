binds {
    // Application launchers
    Mod+Return hotkey-overlay-title="Open Terminal" { spawn "ghostty" "+new-window"; }
    Mod+E hotkey-overlay-title="Open File Manager: Nautilus" { spawn "nautilus" "--new-window"; }
    Mod+C hotkey-overlay-title="Open Calculator" { spawn "gnome-calculator"; }
    Mod+B hotkey-overlay-title="Open btop" { spawn "ghostty" "+new-window" "-e" "btop"; }
    Mod+N hotkey-overlay-title="Open netwatch" { spawn "ghostty" "+new-window" "-e" "netwatch"; }
    Mod+W hotkey-overlay-title="Open Browser" { spawn-sh "xdg-open about:blank"; }

    // Desktop shell
    Mod+D hotkey-overlay-title="Noctalia Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Space hotkey-overlay-title="Noctalia Launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S hotkey-overlay-title="Noctalia Control Center" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma hotkey-overlay-title="Noctalia Settings" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+Shift+Q hotkey-overlay-title="Noctalia Session Menu" { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+Alt+L hotkey-overlay-title="Noctalia Lock Screen" { spawn-sh "noctalia msg session lock"; }
    Print hotkey-overlay-title="Noctalia Screenshot: Region" { spawn-sh "noctalia msg screenshot-region"; }
    Mod+Shift+S { spawn-sh "noctalia msg screenshot-region"; }

    // Audio, media, and brightness
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // Window focus
    Mod+Left { focus-column-left; }
    Mod+H { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+L { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+K { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+J { focus-window-down; }
    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp { focus-column-left; }

    // Window movement
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+J { move-window-down; }

    // Monitor navigation
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Ctrl+Shift+Left { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+Up { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Down { move-column-to-monitor-down; }

    // Workspace navigation
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Tab { focus-workspace-previous; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // Workspace movement
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    // Preset sizing
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    // Window layout
    Mod+Ctrl+C { center-visible-columns; }
    Mod+F { expand-column-to-available-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Window state
    Mod+Q { close-window; }
    Mod+T { toggle-window-floating; }
    Mod+Shift+F { fullscreen-window; }

    // Compositor and session
    Mod+O { toggle-overview; }
    Mod+Slash hotkey-overlay-title="Show Niri Hotkeys" { show-hotkey-overlay; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
}
