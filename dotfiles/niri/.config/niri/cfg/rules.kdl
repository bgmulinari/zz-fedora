// Layer rules only. Window rules are seeded into the DMS-editable
// ~/.config/niri/dms/windowrules.kdl (templates/niri/dms-windowrules.kdl) so
// Settings -> Window Rules can show and edit them; a window-rule kept here
// would be invisible to that UI. The default corner radius, clip, and
// tiled-state rule is generated by DMS into dms/layout.kdl.

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

layer-rule {
    match namespace="dms:blurwallpaper"
    place-within-backdrop true
}
