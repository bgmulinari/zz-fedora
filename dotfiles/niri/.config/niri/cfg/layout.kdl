// Colors come from dms/colors.kdl, which loads later, so setting them here
// does nothing.
//
// Gaps are ours: the settings seed pins niriLayoutGapsOverride = -2 ("Off"),
// the only mode where DMS omits its own gaps line and this one applies.
//
// Border and focus-ring widths are not ours. DMS writes both unconditionally
// from niriLayoutBorderSize, falling back to 2 even with the override off, so
// a width set here would be dead config. Change it in Settings -> Compositor
// Layout, or pin niriLayoutBorderSize in the settings seed.

layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=6
        draw-behind-window false
    }

    tab-indicator {
        width 4
    }

    struts {}
}
