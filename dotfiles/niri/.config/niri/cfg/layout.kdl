// Layout facts DMS does not own. Gaps, border width, focus-ring width, and
// every color are set by DMS through ~/.config/niri/dms/{layout,colors}.kdl,
// which load after this file. Setting them here would be dead config and
// would hide them from the DMS Settings UI, so leave them to DMS.

layout {
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=6
        draw-behind-window false
    }

    tab-indicator {
        width 4
    }

    struts {}
}
