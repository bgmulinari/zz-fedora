// Product-owned Niri defaults loaded from ~/.zz.
//
// Keybinds are deliberately absent: they live in the user-owned
// ~/.config/niri/dms/binds.kdl (seeded from templates/niri/dms-binds.kdl)
// because DMS only surfaces binds from that fragment in Settings -> Keybinds.

include "./cfg/animation.kdl"
include "./cfg/autostart.kdl"
include "./cfg/input.kdl"
include "./cfg/layout.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"
include optional=true "~/.local/share/icons/Qogir/zz-niri.kdl"
