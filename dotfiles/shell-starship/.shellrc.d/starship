if [[ -n "${ZSH_VERSION:-}" ]]; then
  _zz_shell="zsh"
elif [[ -n "${BASH_VERSION:-}" ]]; then
  _zz_shell="bash"
fi

# The prompt only exists in interactive shells; skip the init subprocess in
# the non-interactive login shells that also load the rc files.
if [[ $- == *i* && -n "${_zz_shell:-}" ]] && command -v starship >/dev/null 2>&1; then
  eval "$(starship init "$_zz_shell")"
fi

unset _zz_shell
