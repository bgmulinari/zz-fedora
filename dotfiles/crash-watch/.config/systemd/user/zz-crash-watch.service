[Unit]
Description=Announce process crashes and offer an AI diagnosis
# Needs the session bus to notify and a terminal to open the diagnosis in.
# Both are up only after graphical-session.target.
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# Set by `zz crash capture off`. Checked here so a disabled watcher stays
# disabled across logins without the unit having to be disabled.
ConditionPathExists=!%h/.local/state/zz-fedora/crash-capture-off

[Service]
Type=simple
ExecStart=%h/.local/bin/zz crash watch
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
