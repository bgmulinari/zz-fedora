#!/usr/bin/env bash
# Run one ZZ menu action in a terminal window. By default the window holds
# after the command ends until a key is pressed, so output and any sudo
# prompt are on screen; --no-hold is for interactive programs (an editor, a
# monitor, an AI agent), whose window closes when they exit.
#
# Usage: zz-menu-run [--no-hold] <command line>
set -Eeuo pipefail

hold=1
if [[ "${1:-}" == "--no-hold" ]]; then
  hold=0
  shift
fi
if [[ $# -lt 1 || -z "$1" ]]; then
  printf 'Usage: zz-menu-run [--no-hold] <command line>\n' >&2
  exit 2
fi

export ZZ_MENU_COMMAND="$*"
# The same tool directories the menu's guards were evaluated with, so a row
# shown because dotnet exists runs in a shell that finds dotnet: the
# per-user .NET install and its tools ahead, the Homebrew prefix behind,
# the way the installer's action shell orders them.
export DOTNET_ROOT="${DOTNET_ROOT:-$HOME/.dotnet}"
export PATH="$HOME/.local/bin:$DOTNET_ROOT:$DOTNET_ROOT/tools:${PATH:-/usr/local/bin:/usr/bin}:/home/linuxbrew/.linuxbrew/bin"
# A login shell so the user's own profile applies too. The variables in the
# script are expanded by that shell, not this one.
if [[ "$hold" -eq 1 ]]; then
  # 130 is the user bailing out with Ctrl-C; that needs no prompt. The
  # prompt goes to the terminal itself, and any key answers it.
  # shellcheck disable=SC2016
  script='printf "$ %s\n\n" "$ZZ_MENU_COMMAND"
eval "$ZZ_MENU_COMMAND"
status=$?
if [ "$status" -ne 130 ] && { : <>/dev/tty; } 2>/dev/null; then
  if [ "$status" -eq 0 ]; then
    printf "\n\033[32m●\033[0m Done. Press any key to close." >/dev/tty
  else
    printf "\n\033[31m●\033[0m Failed (status %s). Press any key to close." "$status" >/dev/tty
  fi
  read -rsn 1 </dev/tty
fi'
else
  # shellcheck disable=SC2016
  script='eval "$ZZ_MENU_COMMAND"'
fi

# xdg-terminal-exec resolves the default terminal ZZ configures; the
# fallbacks cover a session where that entry is missing.
if command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec xdg-terminal-exec --title="$ZZ_MENU_COMMAND" -- bash -lc "$script"
fi
if command -v ghostty >/dev/null 2>&1; then
  exec ghostty +new-window -e bash -lc "$script"
fi
exec "${TERMINAL:-xterm}" -e bash -lc "$script"
