# ZZ-managed btop theme rendered by the DMS matugen pipeline; the static
# fallback seeded from templates/btop/dank.theme carries the same keys.
theme[main_bg]="{{colors.background.default.hex}}"
theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="{{colors.on_surface.default.hex}}"
theme[hi_fg]="{{colors.primary.default.hex}}"
theme[selected_bg]="{{colors.surface_container_high.default.hex}}"
theme[selected_fg]="{{colors.primary.default.hex}}"
theme[inactive_fg]="{{colors.outline.default.hex}}"
theme[graph_text]="{{colors.on_surface_variant.default.hex}}"
theme[meter_bg]="{{colors.surface_container_high.default.hex}}"
theme[proc_misc]="{{colors.tertiary.default.hex}}"
theme[cpu_box]="{{colors.primary.default.hex}}"
theme[mem_box]="{{colors.secondary.default.hex}}"
theme[net_box]="{{colors.tertiary.default.hex}}"
theme[proc_box]="{{colors.primary.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"
theme[temp_start]="{{dank16.color2.default.hex}}"
theme[temp_mid]="{{dank16.color3.default.hex}}"
theme[temp_end]="{{dank16.color1.default.hex}}"
theme[cpu_start]="{{dank16.color2.default.hex}}"
theme[cpu_mid]="{{dank16.color3.default.hex}}"
theme[cpu_end]="{{dank16.color1.default.hex}}"
theme[free_start]="{{colors.surface_container_high.default.hex}}"
theme[free_mid]=""
theme[free_end]="{{colors.secondary.default.hex}}"
theme[cached_start]="{{colors.surface_container_high.default.hex}}"
theme[cached_mid]=""
theme[cached_end]="{{colors.tertiary.default.hex}}"
theme[available_start]="{{colors.primary_container.default.hex}}"
theme[available_mid]=""
theme[available_end]="{{colors.primary.default.hex}}"
theme[used_start]="{{dank16.color2.default.hex}}"
theme[used_mid]="{{dank16.color3.default.hex}}"
theme[used_end]="{{dank16.color1.default.hex}}"
theme[download_start]="{{colors.primary_container.default.hex}}"
theme[download_mid]=""
theme[download_end]="{{colors.primary.default.hex}}"
theme[upload_start]="{{colors.surface_container_high.default.hex}}"
theme[upload_mid]=""
theme[upload_end]="{{colors.tertiary.default.hex}}"
theme[process_start]="{{dank16.color2.default.hex}}"
theme[process_mid]="{{dank16.color3.default.hex}}"
theme[process_end]="{{dank16.color1.default.hex}}"
