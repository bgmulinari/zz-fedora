#!/usr/bin/env bash
set -Eeuo pipefail

# Select the Yaru icon-theme variant nearest to the current DMS accent
# color and apply it to GTK (gsettings), which the shell also reads while its
# icon setting stays at "System Default".
# Runs as the post-hook of the ZZ matugen drop-in whenever DMS regenerates
# its theme templates; the accent file is that template's output. Qt and
# KDE apps are deliberately left alone: they keep the Breeze icon theme
# seeded in qt6ct.conf and kdeglobals, because Yaru's symbolic icons carry
# a fixed grey fill that only GTK recolors and KDE's Breeze fallback icons
# are only recolored under a theme that follows the color scheme.

accent_file="${XDG_CACHE_HOME:-$HOME/.cache}/dms/icon-theme-accent"
accent=""
if [[ -f "$accent_file" ]]; then
  accent="$(tr -d '[:space:]' <"$accent_file")"
fi

if [[ ! "$accent" =~ ^#[0-9a-fA-F]{6}$ ]]; then
  accent="#3584e4"
fi

hex_to_rgb() {
  local hex="${1#\#}"
  printf '%d %d %d\n' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

rgb_chroma() {
  local r="$1" g="$2" b="$3" max min
  max="$r"
  ((g > max)) && max="$g"
  ((b > max)) && max="$b"
  min="$r"
  ((g < min)) && min="$g"
  ((b < min)) && min="$b"
  printf '%d\n' "$((max - min))"
}

rgb_hue() {
  local r="$1" g="$2" b="$3" max min delta hue
  max="$r"
  ((g > max)) && max="$g"
  ((b > max)) && max="$b"
  min="$r"
  ((g < min)) && min="$g"
  ((b < min)) && min="$b"
  delta="$((max - min))"

  if ((delta == 0)); then
    printf '0\n'
  elif ((max == r)); then
    hue="$((60 * (g - b) / delta))"
    ((hue < 0)) && hue="$((hue + 360))"
    printf '%d\n' "$hue"
  elif ((max == g)); then
    printf '%d\n' "$((60 * (b - r) / delta + 120))"
  else
    printf '%d\n' "$((60 * (r - g) / delta + 240))"
  fi
}

hue_distance() {
  local h1="$1" h2="$2" diff
  diff="$((h1 > h2 ? h1 - h2 : h2 - h1))"
  ((diff > 180)) && diff="$((360 - diff))"
  printf '%d\n' "$diff"
}

icon_theme_exists() {
  local theme="$1"
  local data_dirs data_dir

  [[ -d "$HOME/.local/share/icons/$theme" || -d "$HOME/.icons/$theme" ]] && return 0

  data_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  while IFS= read -r data_dir; do
    [[ -n "$data_dir" ]] || continue
    [[ -d "$data_dir/icons/$theme" ]] && return 0
  done < <(tr ':' '\n' <<<"$data_dirs")

  return 1
}

read -r accent_r accent_g accent_b < <(hex_to_rgb "$accent")
accent_chroma="$(rgb_chroma "$accent_r" "$accent_g" "$accent_b")"
accent_hue="$(rgb_hue "$accent_r" "$accent_g" "$accent_b")"

best_theme=""
best_distance=""
theme_locked=false

if ((accent_chroma < 24)); then
  for theme in Yaru-gray Yaru-grey Yaru-dark Yaru; do
    if icon_theme_exists "$theme"; then
      best_theme="$theme"
      theme_locked=true
      break
    fi
  done
fi

while read -r theme hex; do
  [[ "$theme_locked" == false ]] || break
  icon_theme_exists "$theme" || continue
  read -r theme_r theme_g theme_b < <(hex_to_rgb "$hex")
  distance="$(hue_distance "$accent_hue" "$(rgb_hue "$theme_r" "$theme_g" "$theme_b")")"
  if [[ -z "$best_distance" || "$distance" -lt "$best_distance" ]]; then
    best_distance="$distance"
    best_theme="$theme"
  fi
done <<'EOF'
Yaru-blue #3584e4
Yaru-purple #9141ac
Yaru-magenta #c061cb
Yaru-red #e01b24
Yaru-olive #4e9a06
Yaru-sage #8ff0a4
Yaru-prussiangreen #308280
Yaru-yellow #f5c211
Yaru-wartybrown #986a44
EOF

[[ -n "$best_theme" ]] || exit 0

# The shell reads settings.ini ahead of gsettings. DMS adds the key there once a
# theme is picked in its settings, so keep any existing value in step.
for settings_file in "${XDG_CONFIG_HOME:-$HOME/.config}"/gtk-{3,4}.0/settings.ini; do
  if [[ -w "$settings_file" ]]; then
    sed -i "s/^gtk-icon-theme-name *=.*/gtk-icon-theme-name=$best_theme/" "$settings_file"
  fi
done

# gsettings exits 0 when dconf cannot commit a write, which dconf reports only
# as a warning, so reading the key back is what proves it was saved.
gsettings set org.gnome.desktop.interface icon-theme "$best_theme"
[[ "$(gsettings get org.gnome.desktop.interface icon-theme)" == "'$best_theme'" ]]
