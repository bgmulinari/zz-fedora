#!/usr/bin/env bash
set -Eeuo pipefail

# Publish the rendered DMS palette as Strata's "dms" theme. Strata rereads a
# changed theme file in every open window, but a Strata that starts while the
# file is missing or half-written replaces the selected id with its fallback
# theme and saves that, so the copy lands by rename, from a name without the
# .toml suffix Strata loads. An unchanged render is not republished.

rendered="${XDG_CACHE_HOME:-$HOME/.cache}/dms/strata-theme.toml"
published="${XDG_CONFIG_HOME:-$HOME/.config}/strata/themes/dms.toml"

[[ -s "$rendered" ]] || exit 0
cmp -s "$rendered" "$published" && exit 0

mkdir -p "$(dirname "$published")"
temporary="$(mktemp "$published.XXXXXX")"
trap 'rm -f "$temporary"' EXIT
cp "$rendered" "$temporary"
chmod 0644 "$temporary"
mv "$temporary" "$published"
