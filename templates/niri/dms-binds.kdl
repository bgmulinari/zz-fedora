// ZZ keybind defaults, seeded into ~/.config/niri/dms/binds.kdl.
//
// This file is user-owned: DMS reads it for Settings -> Keybinds and writes
// back to it when a bind is changed there. The first write rewrites the whole
// file, dropping the comments and section grouping below while keeping every
// bind, so treat that layout as seed-time formatting only.
//
// DMS shows only what lives in this fragment; binds in other niri config
// files are invisible to its UI. Keep ZZ's defaults here, not in
// dotfiles/niri/.config/niri/cfg/, or they drop out of the Settings UI.
//
// Re-seed the shipped defaults over a modified file with:
//   zz refresh niri/dms/binds.kdl

binds {
    // Application launchers
    Mod+Return hotkey-overlay-title="Open Terminal" { spawn "ghostty" "+new-window"; }
    Mod+E hotkey-overlay-title="Open File Manager: Nautilus" { spawn "nautilus" "--new-window"; }
    Mod+C hotkey-overlay-title="Open Calculator" { spawn "gnome-calculator"; }
    Mod+B hotkey-overlay-title="Open btop" { spawn "ghostty" "+new-window" "-e" "btop"; }
    Mod+Shift+N hotkey-overlay-title="Open netwatch" { spawn "ghostty" "+new-window" "-e" "netwatch"; }
    Mod+W hotkey-overlay-title="Open Browser" { spawn-sh "xdg-open about:blank"; }

    // Desktop shell
    Mod+D hotkey-overlay-title="DMS Launcher" { spawn-sh "dms ipc call spotlight toggle"; }
    Mod+Space hotkey-overlay-title="DMS Launcher" { spawn-sh "dms ipc call spotlight toggle"; }
    Mod+S hotkey-overlay-title="DMS Control Center" { spawn-sh "dms ipc call control-center toggle"; }
    Mod+Comma hotkey-overlay-title="DMS Settings" { spawn-sh "dms ipc call settings focusOrToggle"; }
    Mod+V hotkey-overlay-title="DMS Clipboard History" { spawn-sh "dms ipc call clipboard toggle"; }
    Mod+N hotkey-overlay-title="DMS Notifications" { spawn-sh "dms ipc call notifications toggle"; }
    Mod+M hotkey-overlay-title="DMS Process List" { spawn-sh "dms ipc call processlist focusOrToggle"; }
    Mod+Shift+Q hotkey-overlay-title="DMS Power Menu" { spawn-sh "dms ipc call powermenu toggle"; }
    Mod+Alt+L hotkey-overlay-title="DMS Lock Screen" { spawn-sh "dms ipc call lock lock"; }
    Print hotkey-overlay-title="DMS Screenshot: Region" { spawn "dms" "screenshot"; }
    Ctrl+Print hotkey-overlay-title="DMS Screenshot: Full Screen" { spawn "dms" "screenshot" "full"; }
    Alt+Print hotkey-overlay-title="DMS Screenshot: Window" { spawn "dms" "screenshot" "window"; }
    Mod+Shift+S { spawn "dms" "screenshot"; }

    // Audio, media, and brightness
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "dms ipc call audio increment 3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "dms ipc call audio decrement 3"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "dms ipc call audio mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "dms ipc call mic mute"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "dms ipc call mpris next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "dms ipc call mpris previous"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "dms ipc call mpris playPause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "dms ipc call mpris playPause"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "dms ipc call brightness increment 5 ''"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "dms ipc call brightness decrement 5 ''"; }

    // Window focus
    Mod+Left { focus-column-left; }
    Mod+H { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+L { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+K { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+J { focus-window-down; }
    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp { focus-column-left; }

    // Window movement
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+J { move-window-down; }

    // Monitor navigation
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Ctrl+Shift+Left { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+Up { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Down { move-column-to-monitor-down; }

    // Workspace navigation
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Tab { focus-workspace-previous; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // Workspace movement
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    // Preset sizing
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    // Window layout
    Mod+Ctrl+C { center-visible-columns; }
    Mod+F { expand-column-to-available-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Window state
    Mod+Q { close-window; }
    Mod+T { toggle-window-floating; }
    Mod+Shift+F { fullscreen-window; }

    // Compositor and session
    Mod+O { toggle-overview; }
    Mod+Slash hotkey-overlay-title="Show Niri Hotkeys" { show-hotkey-overlay; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
}
