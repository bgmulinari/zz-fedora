{
  "currentThemeCategory": "registry",
  "currentThemeName": "custom",
  "registryThemeVariants": {
    "catppuccin": {
      "dark": {
        "flavor": "mocha",
        "accent": "blue"
      },
      "light": {
        "flavor": "latte",
        "accent": "blue"
      }
    }
  },
  "fontFamily": "Adwaita Sans",
  "monoFontFamily": "JetBrainsMono Nerd Font",
  "radiusMode": "scale",
  "fixedRadius": 0,
  "popupTransparency": 0.9,
  "widgetBackgroundColor": "sth",
  "blurEnabled": true,
  "blurWallpaperOnOverview": true,
  "barElevationEnabled": false,
  "dockConfigs": [
    {
      "id": "dock",
      "name": "Dock",
      "smartAutoHide": true
    }
  ],
  "notificationCompactMode": true,
  "notificationShowTimeoutBar": true,
  "notificationPopupBodyInvokesAction": true,
  "notificationFocusedMonitor": true,
  "updaterCheckOnStart": true,
  "updaterUseCustomCommand": true,
  "updaterCustomCommand": "zz update all",
  "niriLayoutGapsOverride": -2,
  "keyboardNumlock": true,
  "focusFollowsMouse": 1,
  "barConfigs": [
    {
      "id": "default",
      "name": "Main Bar",
      "enabled": true,
      "leftWidgets": [
        {
          "id": "launcherButton",
          "launcherLogoMode": "custom",
          "launcherLogoCustomPath": "/usr/share/icons/hicolor/scalable/apps/start-here.svg",
          "launcherLogoColorOverride": "surface"
        },
        {
          "id": "workspaceSwitcher",
          "showWorkspaceIndex": true,
          "workspaceIndicatorStyle": "cards"
        },
        "focusedWindow"
      ],
      "centerWidgets": [
        "music",
        "clock",
        "weather"
      ],
      "rightWidgets": [
        "systemTray",
        "zzMenu",
        "clipboard",
        "cpuUsage",
        {
          "id": "memUsage",
          "showInGb": true
        },
        "github",
        "agentUsage",
        "notificationButton",
        {
          "id": "systemUpdate",
          "hideWhenIdle": true
        },
        "battery",
        "controlCenterButton"
      ],
      "spacing": 0,
      "innerPadding": 0,
      "squareCorners": true,
      "noBackground": true,
      "fontScale": 1.2
    }
  ],
  "acLockTimeout": 300,
  "acPostLockMonitorTimeout": 30,
  "batteryLockTimeout": 300,
  "batteryPostLockMonitorTimeout": 30,
  "fadeToDpmsGracePeriod": 10,
  "fadeToLockGracePeriod": 10,
  "notificationRules": [
    {
      "enabled": true,
      "field": "appName",
      "pattern": "niri",
      "matchType": "exact",
      "conditions": [
        {
          "field": "summary",
          "matchType": "exact",
          "pattern": "Screenshot captured"
        }
      ],
      "action": "ignore",
      "urgency": "default",
      "bypassDnd": false
    }
  ]
}
