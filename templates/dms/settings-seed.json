{
  "currentThemeCategory": "registry",
  "currentThemeName": "custom",
  "registryThemeVariants": {
    "catppuccin": {
      "dark": {
        "flavor": "mocha",
        "accent": "blue"
      },
      "light": {
        "flavor": "latte",
        "accent": "blue"
      }
    }
  },
  "fontFamily": "Adwaita Sans",
  "monoFontFamily": "JetBrainsMono Nerd Font",
  "radiusMode": "fixed",
  "fixedRadius": 0,
  "popupTransparency": 0.9,
  "widgetBackgroundColor": "sth",
  "blurEnabled": true,
  "blurWallpaperOnOverview": true,
  "barElevationEnabled": false,
  "dockConfigs": [
    {
      "id": "dock",
      "name": "Dock",
      "smartAutoHide": true
    }
  ],
  "notificationCompactMode": true,
  "notificationShowTimeoutBar": true,
  "notificationPopupBodyInvokesAction": true,
  "updaterCheckOnStart": true,
  "updaterUseCustomCommand": true,
  "updaterCustomCommand": "zz update all",
  "niriLayoutGapsOverride": -2,
  "keyboardNumlock": true,
  "focusFollowsMouse": 1,
  "barConfigs": [
    {
      "id": "default",
      "name": "Main Bar",
      "enabled": true,
      "leftWidgets": [
        {
          "id": "launcherButton",
          "launcherLogoMode": "custom",
          "launcherLogoCustomPath": "/usr/share/icons/hicolor/scalable/apps/start-here.svg",
          "launcherLogoColorOverride": "surface",
          "launcherLogoSizeOffset": -2
        },
        {
          "id": "workspaceSwitcher",
          "showWorkspaceIndex": true
        },
        "focusedWindow"
      ],
      "centerWidgets": [
        "music",
        "clock",
        "weather"
      ],
      "rightWidgets": [
        "systemTray",
        "zzMenu",
        "clipboard",
        "cpuUsage",
        {
          "id": "memUsage",
          "showInGb": true
        },
        "github",
        "agentUsage",
        "battery",
        "notificationButton",
        {
          "id": "systemUpdate",
          "hideWhenIdle": true
        },
        "controlCenterButton"
      ],
      "spacing": 0,
      "innerPadding": 0,
      "squareCorners": true,
      "noBackground": true,
      "fontScale": 1.2
    }
  ],
  "acLockTimeout": 300,
  "acPostLockMonitorTimeout": 30,
  "batteryLockTimeout": 300,
  "batteryPostLockMonitorTimeout": 30,
  "fadeToDpmsGracePeriod": 10,
  "fadeToLockGracePeriod": 10
}
